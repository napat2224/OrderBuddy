# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# LINE Developers console -> your Messaging API channel
LINE_CHANNEL_SECRET=          # Basic settings tab -> Channel secret
LINE_CHANNEL_ACCESS_TOKEN=    # Messaging API tab -> Channel access token (long-lived)
                              # empty = dry run: replies are printed in the terminal

# Any long random string; staff send it as header X-Staff-Key
# e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
STAFF_API_KEY=

# Harness config for the agent: C2 (no retry) or C3 (full)
AGENT_CONFIG=C3
